# Copy to .env (compose reads it; `pnpm -F api dev` loads it too).
# Local values only — production secrets live on the VPS (T0.16).
# Every variable below without a leading # is required: the API refuses
# to boot and names the missing ones (apps/api/src/config.ts).

# Postgres (docker compose service `db`)
DATABASE_URL=postgres://servgrid:servgrid@localhost:5432/servgrid

# Host-port overrides if a port is taken on the machine
# SERVGRID_DB_PORT=5432
# SERVGRID_MINIO_API_PORT=9000
# SERVGRID_MINIO_CONSOLE_PORT=9001
# SERVGRID_CADDY_HTTP_PORT=8081
# SERVGRID_CADDY_HTTPS_PORT=9443

# MinIO (S3-compatible object storage for attachments, §9)
MINIO_ROOT_USER=servgrid
MINIO_ROOT_PASSWORD=servgrid-minio

# --- API (apps/api) -------------------------------------------------------

# NODE_ENV: development | test | staging | production (default development)
# NODE_ENV=development
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# HS256 signing key for access tokens (PLAN-BACKEND.md §4). 32+ chars.
JWT_SECRET=local-dev-only-not-a-secret-change-me-on-the-vps

# How the API reaches MinIO. The keys are the root user above locally.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=servgrid-attachments
S3_ACCESS_KEY_ID=servgrid
S3_SECRET_ACCESS_KEY=servgrid-minio
# S3_REGION=us-east-1

# Optional environment pin (T0.16): when set, the API refuses to boot
# unless S3_BUCKET equals it. The VPS overrides pin this per environment
# (ops/compose.staging.yml, ops/compose.production.yml) so a hand-edited
# .env cannot point staging at the production bucket — it fails at boot,
# loudly. Leave unset locally.
# S3_BUCKET_EXPECTED=servgrid-attachments

# Firebase service account for data-only push (§12.1): inline JSON or a
# file path. The Google project does not exist yet (PLAN-BACKEND.md §15
# item 4), so this placeholder has the right shape and a key that cannot
# sign — boot succeeds, sends fail, and the system is correct with every
# push dropped. Replace before Phase 2.
FCM_SERVICE_ACCOUNT={"project_id":"servgrid-local","client_email":"local@servgrid-local.iam.gserviceaccount.com","private_key":"placeholder"}

# Location pipeline (§8): IST work window and ping retention.
WORK_WINDOW_START=09:00
WORK_WINDOW_END=19:00
PING_RETENTION_DAYS=90
