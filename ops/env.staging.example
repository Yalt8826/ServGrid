# ops/.env for STAGING — copy to /srv/servgrid/staging/.env on the VPS
# and fill the <> values. Generate secrets with:  openssl rand -hex 32
# This file lives OUTSIDE the repo checkout (a deploy's git reset can
# never touch it) and is the only place secrets exist. Compose reads it
# (--env-file and the api container's env_file), the backup scripts
# source it via ENV_FILE.

# --- deployment identity -------------------------------------------------
# Which stack this file drives: staging | production. The backup and
# sync scripts build compose commands and volume paths from it.
SERVGRID_ENV=staging
# This file's own absolute path — ops/compose.yaml feeds it to the api
# container's env_file, so the container reads exactly what you edit.
SERVGRID_ENV_FILE=/srv/servgrid/staging/.env
# Where the repo is checked out on the VPS.
SERVGRID_DIR=/srv/servgrid/app
# CI pushes this to ghcr.io on every merge to main. Pin a digest for
# production; staging tracks the mutable tag CI pushes.
API_IMAGE=ghcr.io/yalt8826/servgrid/api:staging
# Caddy terminates TLS for this name — a DNS A/AAAA record at the VPS.
SERVGRID_DOMAIN=staging.<your-domain>

# --- postgres (staging's own database — never production's) --------------
POSTGRES_USER=servgrid
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=servgrid_staging
# Host directory WAL segments archive into, then ship off-site.
SERVGRID_WAL_DIR=/srv/servgrid/staging/wal-archive

# --- API secrets (the T0.16 checklist) -----------------------------------
# HS256 signing key, 32+ chars.
JWT_SECRET=<openssl rand -hex 32>
# The staging bucket on this VPS's MinIO. MUST stay servgrid-attachments-
# staging: ops/compose.staging.yml pins S3_BUCKET_EXPECTED to this name
# and the API refuses to boot on any other value (T0.16 guard).
S3_BUCKET=servgrid-attachments-staging
# A dedicated MinIO user for the API (not the root user) — created and
# granted on this bucket only by ops/backup/provision-minio.sh.
S3_ACCESS_KEY_ID=<openssl rand -hex 16>
S3_SECRET_ACCESS_KEY=<openssl rand -hex 24>
# Inline JSON or a path to the Firebase service account
# (/etc/servgrid/fcm-service-account.json — see the T0.15 runbook).
FCM_SERVICE_ACCOUNT=/etc/servgrid/fcm-service-account.json
WORK_WINDOW_START=09:00
WORK_WINDOW_END=19:00
PING_RETENTION_DAYS=90
LOG_LEVEL=info

# --- minio root (administration only; the API uses the user above) -------
MINIO_ROOT_USER=<openssl rand -hex 8>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# --- backups: local + off-site -------------------------------------------
BACKUP_DIR=/srv/servgrid/backups/staging
BACKUP_KEEP_LOCAL_DAYS=7
# Dead-man's-switch ping after a successful backup (healthchecks.io or
# equivalent). Empty = no ping — set it before going live.
BACKUP_PING_URL=
# The off-site object store (any S3-compatible provider). OFFSITE_REQUIRED=1
# makes backup.sh FAIL — not warn — when off-site copy cannot run: a
# backup that only reached the VPS disk is not a backup.
OFFSITE_REQUIRED=1
OFFSITE_S3_ENDPOINT=https://<s3 endpoint of the provider>
OFFSITE_S3_ACCESS_KEY_ID=<provider key>
OFFSITE_S3_SECRET_ACCESS_KEY=<provider secret>
# One bucket holding dumps (dumps/) and WAL (wal/) for this environment.
OFFSITE_BUCKET=servgrid-staging-backups
OFFSITE_KEEP_DUMP_DAYS=60
OFFSITE_KEEP_WAL_DAYS=14
# The replicated copy of the attachments bucket (MinIO bucket
# replication target — provision-minio.sh wires it).
OFFSITE_ATTACHMENTS_BUCKET=servgrid-staging-attachments-replica
