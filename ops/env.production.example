# ops/.env for PRODUCTION — same shape as ops/env.staging.example; the
# differences are the values that must never blur: the real domain, the
# production database name, the production bucket, and digest-pinned
# image. Generate secrets with:  openssl rand -hex 32
#
# seed/003_products.sql is dev/staging demo data — production seeds only
# the owner (001) and the service catalogue (002); the real price list
# enters through the API.

# --- deployment identity -------------------------------------------------
SERVGRID_ENV=production
SERVGRID_ENV_FILE=/srv/servgrid/production/.env
SERVGRID_DIR=/srv/servgrid/app
# Digest-pinned: `docker compose pull api` must never drift.
API_IMAGE=ghcr.io/yalt8826/servgrid/api@sha256:<digest of the release image>
SERVGRID_DOMAIN=api.<your-domain>

# --- postgres (production's own database) --------------------------------
POSTGRES_USER=servgrid
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=servgrid
SERVGRID_WAL_DIR=/srv/servgrid/production/wal-archive

# --- API secrets (the T0.16 checklist) -----------------------------------
JWT_SECRET=<openssl rand -hex 32>
# MUST stay servgrid-attachments: ops/compose.production.yml pins
# S3_BUCKET_EXPECTED to this name (T0.16 guard).
S3_BUCKET=servgrid-attachments
S3_ACCESS_KEY_ID=<openssl rand -hex 16>
S3_SECRET_ACCESS_KEY=<openssl rand -hex 24>
FCM_SERVICE_ACCOUNT=/etc/servgrid/fcm-service-account.json
WORK_WINDOW_START=09:00
WORK_WINDOW_END=19:00
PING_RETENTION_DAYS=90
LOG_LEVEL=info

# --- minio root (administration only; the API uses the user above) -------
MINIO_ROOT_USER=<openssl rand -hex 8>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>

# --- backups: local + off-site -------------------------------------------
BACKUP_DIR=/srv/servgrid/backups/production
BACKUP_KEEP_LOCAL_DAYS=7
BACKUP_PING_URL=
OFFSITE_REQUIRED=1
OFFSITE_S3_ENDPOINT=https://<s3 endpoint of the provider>
OFFSITE_S3_ACCESS_KEY_ID=<provider key>
OFFSITE_S3_SECRET_ACCESS_KEY=<provider secret>
OFFSITE_BUCKET=servgrid-production-backups
OFFSITE_KEEP_DUMP_DAYS=60
OFFSITE_KEEP_WAL_DAYS=14
OFFSITE_ATTACHMENTS_BUCKET=servgrid-production-attachments-replica
